# --- Général ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Base de données (voir infra/docker-compose.yml) -------------------------
DATABASE_URL=postgres://dedale:dedale@localhost:5432/dedale
TEST_DATABASE_URL=postgres://dedale:dedale@localhost:5432/dedale_test

# --- API ------------------------------------------------------------------------
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Origines supplémentaires autorisées (CORS/CSRF), séparées par des virgules.
TRUSTED_ORIGINS=
# Secret de signature des sessions : 32 caractères minimum (openssl rand -base64 32).
AUTH_SECRET=remplacez-moi-par-un-secret-de-32-caracteres-minimum

# --- Connexion sociale (optionnel) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Paiements : sans clé Stripe, un prestataire simulé règle tout instantanément
# (refusé en production, sauf instance de démonstration : DEMO_MODE=true).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEMO_MODE=false

# --- Muse (assistante d'écriture IA) : sans clé, une Muse hors ligne est utilisée
ANTHROPIC_API_KEY=
MUSE_MODEL=claude-opus-5-5

# --- Web ------------------------------------------------------------------------
# Adresse de l'API vue par le serveur Next.js (rendu serveur).
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mobile (Expo) ---------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000
